{
  "rules": {
    ".read": false,
    ".write": false,
    "walkers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n','r','ts']) && newData.child('ts').val() === now",
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "r": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "m": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "t": {
          "$i": {
            "i": {
              ".validate": "newData.isString() && newData.val().length < 60000 && newData.val().beginsWith('data:image/')"
            },
            "p": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "woofs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.exists()) || ($uid === auth.uid && !newData.exists()))",
          ".validate": "newData.hasChildren(['a','from','by','ts']) && newData.child('a').isString() && newData.child('a').val().matches(/^(woof|hi|heart)$/) && newData.child('from').isString() && newData.child('from').val().length <= 16 && newData.child('by').val() === auth.uid && newData.child('ts').val() === now"
        }
      }
    },
    "pop": {
      "$cell": {
        ".read": "auth != null",
        "$pid": {
          "u": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val().length < 600 && (newData.val().beginsWith('https://images.unsplash.com/') || newData.val().beginsWith('https://upload.wikimedia.org/'))"
          },
          "th": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val().length < 600 && (newData.val().beginsWith('https://images.unsplash.com/') || newData.val().beginsWith('https://upload.wikimedia.org/'))"
          },
          "cr": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val().length < 80"
          },
          "votes": {
            "$voter": {
              ".write": "auth != null && auth.uid === $voter",
              ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 3)"
            }
          }
        }
      }
    },
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && ((auth.uid === $from) || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['n','pid','ts']) && newData.child('n').isString() && newData.child('n').val().length <= 16 && newData.child('pid').isString() && newData.child('pid').val().length <= 40 && newData.child('ts').val() === now"
        }
      }
    },
    "parties": {
      "$pid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('leader').val() === auth.uid && newData.child('members').child(auth.uid).exists()) || (data.child('leader').val() === auth.uid && !newData.exists()))",
        "leader": {
          ".write": "auth != null && (data.val() === auth.uid || (newData.val() === auth.uid && root.child('parties').child($pid).child('members').child(auth.uid).exists()))",
          ".validate": "newData.isString() && newData.parent().child('members').child(newData.val()).exists()"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || root.child('invites').child($uid).child(root.child('parties').child($pid).child('leader').val()).child('pid').val() === $pid)) || root.child('parties').child($pid).child('leader').val() === auth.uid)",
            ".validate": "newData.isString() && newData.val().length <= 16"
          }
        },
        "state": {
          ".write": "auth != null && root.child('parties').child($pid).child('leader').val() === auth.uid",
          ".validate": "newData.hasChildren(['lat','lng','ts']) && newData.child('ts').val() === now",
          "lat": {
            ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
          },
          "lng": {
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "h": {
            ".validate": "newData.isNumber()"
          },
          "w": {
            ".validate": "newData.isBoolean()"
          },
          "m": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "r": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "lb": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$o": {
            ".validate": false
          }
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$o": {
          ".validate": false
        },
        "shoot": {
          ".write": "auth != null && root.child('parties').child($pid).child('members').child(auth.uid).exists()",
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "spn": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "lat": {
            ".validate": "newData.isNumber()"
          },
          "lng": {
            ".validate": "newData.isNumber()"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "go": {
            ".validate": "newData.isNumber()"
          },
          "acc": {
            "$u": {
              ".write": "auth != null && auth.uid === $u && root.child('parties').child($pid).child('members').child(auth.uid).exists()",
              ".validate": "newData.isBoolean()"
            }
          },
          "$o": {
            ".validate": false
          }
        }
      }
    },
    "nosv": {
      ".read": "auth != null",
      "$cell": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.val() === true && $cell.matches(/^-?[0-9]{1,6}_-?[0-9]{1,6}$/)"
      }
    },
    "pteams": {
      "$pid": {
        ".read": "auth != null && root.child('parties').child($pid).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('parties').child($pid).child('members').child(auth.uid).exists())",
          "$i": {
            ".validate": "$i.matches(/^[0-3]$/) && newData.hasChildren(['i'])",
            "i": {
              ".validate": "newData.isString() && newData.val().length < 200000 && newData.val().beginsWith('data:image/')"
            },
            "p": {
              ".validate": "newData.isBoolean()"
            },
            "$o": {
              ".validate": false
            }
          }
        }
      }
    },
    "pshot": {
      "$pid": {
        ".read": "auth != null && root.child('parties').child($pid).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('parties').child($pid).child('members').child(auth.uid).exists())",
          "live": {
            ".validate": "newData.hasChildren(['i','ts'])",
            "i": {
              ".validate": "newData.isString() && newData.val().length < 100000 && newData.val().beginsWith('data:image/')"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "go": {
              ".validate": "newData.isNumber()"
            },
            "$o": {
              ".validate": false
            }
          },
          "fin": {
            ".validate": "newData.hasChildren(['i','ts'])",
            "i": {
              ".validate": "newData.isString() && newData.val().length < 450000 && newData.val().beginsWith('data:image/')"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "go": {
              ".validate": "newData.isNumber()"
            },
            "$o": {
              ".validate": false
            }
          },
          "res": {
            ".validate": "newData.hasChildren(['i','ts'])",
            "i": {
              ".validate": "newData.isString() && newData.val().length < 720000 && newData.val().beginsWith('data:image/')"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "go": {
              ".validate": "newData.isNumber()"
            },
            "$o": {
              ".validate": false
            }
          },
          "$o": {
            ".validate": false
          }
        }
      }
    }
  }
}